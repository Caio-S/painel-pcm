# Postgres (Supabase) — deixe em branco para usar SQLite local automaticamente.
# Use a connection string do "Session pooler" do Supabase (porta 5432), não a direct connection IPv6.
DATABASE_URL=

SECRET_KEY=dev

# MySQL/MariaDB da empresa — somente leitura, view vw_ordem_servico_frota / vw_bi_fluxo_dFrota.
# Mesmo banco já usado pelo bot do WhatsApp (Projeto chat bot/db_config.json).
MARIADB_HOST=rdscontroladoria-read.grupojapungu.com
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASS=
MARIADB_DB=syscustoWeb

# id_empresa (separados por vírgula) que representam a CRV Industrial / Capinópolis nessas views.
# Confirmado por amostragem: 8 = PFCMO-MG. Ajuste aqui se descobrir outro código.
PCM_EMPRESAS=8
